+std::unique_ptr<server_res_generator> server_routes::handle_wepm(const server_http_req & req,
+                                                                 const std::string &     mode) {
+    auto res = create_response();
+    res->set_req(&req);
+    try {
+        const json  body = json::parse(req.body);
+        bool        chat = mode == "chat", generate = chat || mode == "completion";
+        bool        stream = generate && body.value("stream", false);
+        server_task task(SERVER_TASK_TYPE_WEPM);
+        task.id   = res->rd.get_new_id();
+        json work = {
+            { "task",   generate ? "generate" : mode },
+            { "stream", stream                       }
+        };
+        std::string       prompt;
+        const std::string image = "<|vision_start|><|image_pad|><|vision_end|>";
+        auto              media = [&](std::string value) {
+            if (value.rfind("data:", 0) == 0) {
+                auto split = value.find(";base64,");
+                if (split == std::string::npos) {
+                    throw std::invalid_argument("expected base64 image");
+                }
+                value.erase(0, split + 8);
+            }
+            if (value.size() > 64 * 1024 * 1024 || task.wepm_images.size() >= 64) {
+                throw std::invalid_argument("media limit exceeded");
+            }
+            task.wepm_images.push_back(base64::decode(value));
+        };
+        auto content = [&](const json & value) {
+            if (value.is_string()) {
+                prompt += value.get<std::string>();
+                return;
+            }
+            for (const auto & part : value) {
+                if (part.at("type") == "text") {
+                    prompt += part.at("text").get<std::string>();
+                } else if (part.at("type") == "image_url") {
+                    media(part.at("image_url").at("url"));
+                    prompt += image;
+                } else {
+                    throw std::invalid_argument("unsupported WePM content part");
+                }
+            }
+        };
+        if (mode == "decision") {
+            work["state"]     = body.value("state", json(nullptr));
+            work["questions"] = body.at("questions");
+            for (const auto & im : body.value("images", json::array())) {
+                media(im);
+                prompt += image;
+            }
+        } else if (chat) {
+            for (const auto & msg : body.at("messages")) {
+                auto role = msg.at("role").get<std::string>();
+                if (role != "user" && role != "assistant" && role != "system") {
+                    throw std::invalid_argument("unsupported chat role");
+                }
+                prompt += "<|im_start|>" + role + "\n";
+                content(msg.at("content"));
+                prompt += "<|im_end|>\n";
+            }
+            prompt += "<|im_start|>assistant\n";
+        } else {
+            const auto & input = body.at(generate ? "prompt" : "input");
+            if (input.is_object() && input.contains("prompt_string")) {
+                prompt                   = input.at("prompt_string").get<std::string>();
+                const std::string marker = get_media_marker();
+                size_t            pos    = 0;
+                for (const auto & im : input.at("multimodal_data")) {
+                    pos = prompt.find(marker, pos);
+                    if (pos == std::string::npos) {
+                        throw std::invalid_argument("missing media marker");
+                    }
+                    prompt.replace(pos, marker.size(), image);
+                    pos += image.size();
+                    media(im);
+                }
+            } else if (input.is_object()) {
+                content(input.at("content"));
+            } else {
+                content(input);
+            }
+        }
+        work["prompt"] = prompt;
+        if (generate) {
+            task.params = server_schema::eval_llama_cmpl_schema(ctx_server.vocab, params, meta->logit_bias_eog, body);
+            work["max_tokens"] = body.value("max_tokens", body.value("n_predict", -1));
+            if (body.contains("stop") && !body.at("stop").is_null()) {
+                work["stop"] = body.at("stop").is_string() ? json::array({ body.at("stop") }) : body.at("stop");
+            }
+        } else if (mode == "embed") {
+            work["dimensions"] = body.value("dimensions", 2048);
+            work["truncate"] = body.value("truncate", false);
+        }
+        task.wepm_request = std::move(work);
+        res->rd.post_task(std::move(task));
+        auto first = res->rd.next(req.should_stop);
+        if (!first) {
+            return res;
+        }
+        if (first->is_error()) {
+            res->error(first->to_json());
+            return res;
+        }
+        auto format = [mode, chat, stream, id = gen_chatcmplid()](server_task_result & result) {
+            json b     = result.to_json();
+            bool final = result.is_stop();
+            if (mode == "embed") {
+                return json{
+                    { "data",  json::array({ { { "index", 0 },
+                                              { "embedding", b.at("vector") },
+                                              { "tokens_evaluated", b.at("input_tokens") } } }) },
+                    { "usage", { { "prompt_tokens", b.at("input_tokens") } }                                                 }
+                };
+            }
+            if (mode == "decision") {
+                return json{
+                    { "answers", b.at("answers")                               },
+                    { "usage",   { { "prompt_tokens", b.at("input_tokens") } } }
+                };
+            }
+            std::string text = stream && final ? "" : b.at("content").get<std::string>();
+            if (chat) {
+                json reason = final ? json(b.at("stop_type") == "limit" ? "length" : "stop") : json(nullptr);
+                json choice = {
+                    { "index",                      0                                                },
+                    { "finish_reason",              reason                                           },
+                    { stream ? "delta" : "message", { { "role", "assistant" }, { "content", text } } }
+                };
+                json out = {
+                    { "id",      id                                                   },
+                    { "object",  stream ? "chat.completion.chunk" : "chat.completion" },
+                    { "choices", json::array({ choice })                              }
+                };
+                if (final) {
+                    out["timings"] = b.at("timings");
+                    out["usage"]   = {
+                        { "prompt_tokens",     b.at("input_tokens")        },
+                        { "completion_tokens", b["timings"]["predicted_n"] }
+                    };
+                }
+                return out;
+            }
+            b["content"] = text;
+            b["stop"]    = final;
+            return b;
+        };
+        if (!stream) {
+            res->ok(format(*first));
+            return res;
+        }
+        res->data         = format_oai_sse(format(*first));
+        res->content_type = "text/event-stream";
+        res->set_next([r = res.get(), format, chat](std::string & out) {
+            if (!r->data.empty()) {
+                out.swap(r->data);
+                r->data.clear();
+                return true;
+            }
+            if (!r->rd.has_next()) {
+                out = chat ? "data: [DONE]\n\n" : "";
+                return false;
+            }
+            auto result = r->rd.next([r] { return r->should_stop(); });
+            if (!result) {
+                return false;
+            }
+            out = format_oai_sse(result->is_error() ?
+                                     json{
+                                         { "error", result->to_json() }
+            } :
+                                     format(*result));
+            return true;
+        });
+    } catch (const std::exception & e) {
+        res->error(format_error_response(e.what(), ERROR_TYPE_INVALID_REQUEST));
+    }
+    return res;
+}
