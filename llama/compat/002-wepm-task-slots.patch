new file mode 100644
index 0000000..eedd563
--- /dev/null
+++ b/tools/server/wepm/blas.hpp
@@ -0,0 +1,69 @@
+// The projection matrices are row-major. Prefer the platform BLAS when available.
+#pragma once
+#ifdef WEPM_USE_ACCELERATE
+#    include <Accelerate/Accelerate.h>
+#elif defined(WEPM_USE_CBLAS)
+#    include <cblas.h>
+#else
+#    include <algorithm>
+#    include <cmath>
+
+namespace wepm {
+enum { CblasRowMajor, CblasNoTrans, CblasTrans };
+
+inline float cblas_sdot(int n, const float * x, int ix, const float * y, int iy) {
+    float sum = 0;
+    for (int i = 0; i < n; ++i) {
+        sum += x[i * ix] * y[i * iy];
+    }
+    return sum;
+}
+
+inline void cblas_saxpy(int n, float a, const float * x, int ix, float * y, int iy) {
+    for (int i = 0; i < n; ++i) {
+        y[i * iy] += a * x[i * ix];
+    }
+}
+
+inline void cblas_sscal(int n, float a, float * x, int ix) {
+    for (int i = 0; i < n; ++i) {
+        x[i * ix] *= a;
+    }
+}
+
+inline float cblas_snrm2(int n, const float * x, int ix) {
+    return std::sqrt(cblas_sdot(n, x, ix, x, ix));
+}
+
+inline void cblas_sgemm(int,
+                        int,
+                        int           trans_b,
+                        int           m,
+                        int           n,
+                        int           k,
+                        float         alpha,
+                        const float * a,
+                        int           lda,
+                        const float * b,
+                        int           ldb,
+                        float         beta,
+                        float *       c,
+                        int           ldc) {
+    for (int i = 0; i < m; ++i) {
+        float * row = c + i * ldc;
+        for (int j = 0; j < n; ++j) {
+            row[j] *= beta;
+        }
+        if (trans_b == CblasTrans) {
+            for (int j = 0; j < n; ++j) {
+                row[j] += alpha * cblas_sdot(k, a + i * lda, 1, b + j * ldb, 1);
+            }
+        } else {
+            for (int p = 0; p < k; ++p) {
+                cblas_saxpy(n, alpha * a[i * lda + p], b + p * ldb, 1, row, 1);
+            }
+        }
+    }
+}
+}  // namespace wepm
+#endif
diff --git a/tools/server/wepm/decision.hpp b/tools/server/wepm/decision.hpp
new file mode 100644
index 0000000..156c054
--- /dev/null
+++ b/tools/server/wepm/decision.hpp
@@ -0,0 +1,114 @@
+// Visible SystemOne prompt and candidate-row order for task_slots_v1.
+#pragma once
+
+#include "nlohmann/json.hpp"
+
+#include <algorithm>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace wepm {
+using DecisionJson = nlohmann::ordered_json;
+
+struct Decision {
+    std::string              kind, prompt;
+    std::vector<std::string> ids;
+    std::vector<std::string> descriptions;
+
+    DecisionJson answer(const std::vector<float> & probabilities) const {
+        DecisionJson answer = {
+            { "type", kind }
+        };
+        if (kind == "noul") {
+            answer["noul"] = probabilities.at(1);
+        } else {
+            for (size_t i = 0; i < ids.size(); ++i) {
+                answer["probabilities"][ids[i]] = probabilities.at(i);
+            }
+        }
+        if (kind == "choice") {
+            answer["choice"] =
+                ids.at(std::max_element(probabilities.begin(), probabilities.end()) - probabilities.begin());
+        } else if (kind == "score") {
+            double score = 0;
+            for (size_t i = 0; i < ids.size(); ++i) {
+                score += i * probabilities[i];
+                answer["legend"][ids[i]] = descriptions[i];
+            }
+            answer["score"] = score;
+        }
+        return {
+            { "q", answer }
+        };
+    }
+};
+
+inline bool visible(const std::string & text) {
+    return text.find_first_not_of(" \t\n\r\f\v") != std::string::npos;
+}
+
+inline Decision render_decision(const DecisionJson & request) {
+    const auto & questions = request.at("questions");
+    if (!questions.is_object() || questions.size() != 1 || !questions.contains("q")) {
+        throw std::runtime_error("expected questions.q");
+    }
+    const auto & q           = questions.at("q");
+    const auto   kind        = q.at("type").get<std::string>();
+    auto         instruction = q.at("instructions").get<std::string>();
+    if (!visible(instruction)) {
+        throw std::runtime_error("empty instructions");
+    }
+    const auto & state = request.at("state");
+    std::string  context;
+    if (state.is_null() || state == "") {
+        context = instruction;
+    } else if (state.is_string()) {
+        context = state.get<std::string>();
+    } else if (state.is_object()) {
+        context = nlohmann::json::parse(state.dump()).dump();  // recursively sort state keys
+    } else {
+        throw std::runtime_error("invalid state");
+    }
+    Decision result{ kind,
+                     "Evaluate the candidates using the context and instructions.\nContext:\n" + context +
+                         "\nDecision type: " + kind + "\nInstructions:\n" + instruction + "\nCandidates:",
+                     {} };
+    auto     append = [&](const std::string & id, const std::string & description) {
+        if (id.empty() || !visible(description)) {
+            throw std::runtime_error("empty candidate");
+        }
+        result.prompt += "\n" + std::to_string(result.ids.size()) + ": ";
+        if (kind == "choice") {
+            result.prompt += "id=" + DecisionJson(id).dump() + " description=";
+        }
+        result.prompt += DecisionJson(description).dump();
+        result.ids.push_back(id);
+        result.descriptions.push_back(description);
+    };
+    if (kind == "noul") {
+        if (q.contains("criteria")) {
+            throw std::runtime_error("noul has no criteria");
+        }
+        append("false", "No / false");
+        append("true", "Yes / true");
+    } else {
+        const auto & criteria = q.at("criteria");
+        if (criteria.size() < 2 || criteria.size() > 255) {
+            throw std::runtime_error("invalid candidate count");
+        }
+        if (kind == "choice" && criteria.is_object()) {
+            for (const auto & entry : criteria.items()) {
+                append(entry.key(), entry.value().get<std::string>());
+            }
+        } else if (kind == "score" && criteria.is_array()) {
+            for (const auto & description : criteria) {
+                append(std::to_string(result.ids.size()), description.get<std::string>());
+            }
+        } else {
+            throw std::runtime_error("invalid decision criteria");
+        }
+    }
+    return result;
+}
+}  // namespace wepm
diff --git a/tools/server/wepm/engine.hpp b/tools/server/wepm/engine.hpp
new file mode 100644
index 0000000..263d8a8
--- /dev/null
+++ b/tools/server/wepm/engine.hpp
@@ -0,0 +1,505 @@
+#pragma once
+#include "common.h"
+#include "decision.hpp"
+#include "ggml-backend.h"
+#include "ggml.h"
+#include "gguf.h"
+#include "heif.hpp"
+#include "llama.h"
+#include "mgvb.hpp"
+#include "mtmd-helper.h"
+#include "mtmd.h"
+#include "nlohmann/json.hpp"
+#include "sampling.h"
+#include "unicode.h"
+
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <memory>
+#include <numeric>
+#include <optional>
+#include <set>
+
+namespace wepm {
+using json                                = nlohmann::ordered_json;
+template <class T, auto Free> using owner = std::unique_ptr<T, decltype(Free)>;
+
+class TensorFile {
+    owner<gguf_context, gguf_free> info{ nullptr, gguf_free };
+    owner<ggml_context, ggml_free> header{ nullptr, ggml_free };
+    std::ifstream                  file;
+  public:
+    explicit TensorFile(const string & path) : file(path, std::ios::binary) {
+        ggml_context * ctx = nullptr;
+        info.reset(gguf_init_from_file(path.c_str(), { true, &ctx }));
+        header.reset(ctx);
+        if (!info || !header || !file) {
+            throw std::runtime_error("cannot read GGUF " + path);
+        }
+    }
+
+    bool has_wepm_vision_profile() const {
+        if (gguf_find_tensor(info.get(), "unimodel.embedding_head.weight") < 0) {
+            return false;
+        }
+        const auto key = gguf_find_key(info.get(), "clip.vision.wepm_task_slots_v1");
+        return key >= 0 && gguf_get_kv_type(info.get(), key) == GGUF_TYPE_BOOL && gguf_get_val_bool(info.get(), key);
+    }
+
+    Matrix read(const string & name, int first = 0, int count = -1) {
+        const auto * t = ggml_get_tensor(header.get(), name.c_str());
+        if (!t || t->ne[2] != 1 || t->ne[3] != 1) {
+            throw std::runtime_error("invalid tensor " + name);
+        }
+        if (count < 0) {
+            count = t->ne[1];
+        }
+        if (first < 0 || count < 1 || first + int64_t(count) > t->ne[1]) {
+            throw std::runtime_error("tensor row outside " + name);
+        }
+        const auto rowbytes = ggml_row_size(t->type, t->ne[0]);
+        int64_t    index    = gguf_find_tensor(info.get(), name.c_str());
+        file.seekg(gguf_get_data_offset(info.get()) + gguf_get_tensor_offset(info.get(), index) + first * rowbytes);
+        vector<char> buf(count * rowbytes);
+        if (!file.read(buf.data(), buf.size())) {
+            throw std::runtime_error("truncated tensor " + name);
+        }
+        Matrix out(count, t->ne[0]);
+        if (t->type == GGML_TYPE_F32) {
+            std::memcpy(out.row(0), buf.data(), buf.size());
+        } else {
+            auto conv = ggml_get_type_traits(t->type)->to_float;
+            if (!conv) {
+                throw std::runtime_error("unsupported tensor type " + name);
+            }
+            conv(buf.data(), out.row(0), int64_t(out.rows) * out.cols);
+        }
+        return out;
+    }
+
+    Weights tasks() {
+        Weights w;
+        for (int i = 0; i < gguf_get_n_tensors(info.get()); ++i) {
+            string n = gguf_get_tensor_name(info.get(), i);
+            if (n.rfind("unimodel.", 0) == 0 && n.find("reconstruction") == string::npos) {
+                w.emplace(n, read(n));
+            }
+        }
+        return w;
+    }
+};
+
+class Engine {
+    llama_context *     ctx;
+    mtmd_context *      vision;
+    llama_model *       language;
+    TensorFile          dictionary;
+    Weights             weights;
+    const llama_vocab * vocab = nullptr;
+    int                 width = 0;
+    int                 ctxlen;
+
+    vector<llama_token> tokenize(const string & text) {
+        vector<llama_token> ids(text.size() + 1);
+        int                 n = llama_tokenize(vocab, text.data(), text.size(), ids.data(), ids.size(), false, true);
+        if (n < 0) {
+            throw std::runtime_error("tokenization failed");
+        }
+        ids.resize(n);
+        return ids;
+    }
+
+    vector<float> evaluate(const Matrix &                     emb,
+                           const vector<std::array<int, 4>> & positions,
+                           bool                               hidden,
+                           const std::function<bool()> &      cancelled) {
+        if (emb.rows != int(positions.size()) || emb.cols != width) {
+            throw std::runtime_error("bad batch");
+        }
+        llama_set_embeddings(ctx, hidden);
+        const int chunk = std::min<int>(256, llama_n_ubatch(ctx));
+        for (int offset = 0; offset < emb.rows; offset += chunk) {
+            if (cancelled()) {
+                throw std::runtime_error("request cancelled");
+            }
+            int                    n = std::min(emb.rows - offset, chunk);
+            vector<llama_pos>      pos(4 * n);
+            vector<int32_t>        counts(n, 1);
+            llama_seq_id           zero = 0;
+            vector<llama_seq_id *> seqs(n, &zero);
+            vector<int8_t>         outputs(n, 0);
+            outputs.back() = 1;
+            for (int i = 0; i < n; ++i) {
+                for (int j = 0; j < 4; ++j) {
+                    pos[j * n + i] = positions[offset + i][j];
+                }
+            }
+            llama_batch b{};
+            b.n_tokens = n;
+            b.embd     = const_cast<float *>(emb.row(offset));
+            b.pos      = pos.data();
+            b.n_seq_id = counts.data();
+            b.seq_id   = seqs.data();
+            b.logits   = outputs.data();
+            if (llama_decode(ctx, b) != 0) {
+                throw std::runtime_error("llama_decode failed");
+            }
+        }
+        auto data = hidden ? llama_get_embeddings_ith(ctx, -1) : llama_get_logits_ith(ctx, -1);
+        if (!data) {
+            throw std::runtime_error("missing model output");
+        }
+        if (!hidden) {
+            return {};
+        }
+        return { data, data + width };
+    }
+
+    struct ImageInput {
+        owner<mtmd_input_chunks, mtmd_input_chunks_free> chunks;
+        const mtmd_input_chunk *                         chunk;
+        int                                              tokens;
+    };
+
+    ImageInput prepare_image(const string & bytes) {
+        owner<mtmd_bitmap, mtmd_bitmap_free> bm(nullptr, mtmd_bitmap_free);
+        if (is_heif(bytes)) {
+            bm.reset(decode_heif(bytes));
+        } else {
+            auto wrapper =
+                mtmd_helper_bitmap_init_from_buf(vision, reinterpret_cast<const unsigned char *>(bytes.data()),
+                                                 bytes.size(), false, mtmd_helper_init_opt_default());
+            mtmd_helper::video_ptr video(wrapper.video_ctx);
+            bm.reset(wrapper.bitmap);
+            if (video) {
+                throw std::invalid_argument("expected a still image");
+            }
+        }
+        if (!bm || mtmd_bitmap_get_nx(bm.get()) == 0) {
+            throw std::invalid_argument("invalid still image");
+        }
+        owner<mtmd_input_chunks, mtmd_input_chunks_free> parts(mtmd_input_chunks_init(), mtmd_input_chunks_free);
+        mtmd_input_part                                  part{ nullptr, bm.get() };
+        const mtmd_input_part *                          input = &part;
+        if (mtmd_tokenize_from_parts(vision, parts.get(), &input, 1, false)) {
+            throw std::runtime_error("image preprocessing failed");
+        }
+        for (size_t i = 0; i < mtmd_input_chunks_size(parts.get()); ++i) {
+            auto chunk = mtmd_input_chunks_get(parts.get(), i);
+            auto img   = mtmd_input_chunk_get_tokens_image(chunk);
+            if (!img) {
+                continue;
+            }
+            const int n = mtmd_input_chunk_get_n_tokens(chunk);
+            if (n <= 0) {
+                throw std::invalid_argument("empty image grid");
+            }
+            return { std::move(parts), chunk, n };
+        }
+        throw std::invalid_argument("image chunk missing");
+    }
+
+    Visual encode(const ImageInput & input, const Matrix * query) {
+        if (mtmd_encode_chunk(vision, input.chunk)) {
+            throw std::runtime_error("image encode failed");
+        }
+        const auto * img  = mtmd_input_chunk_get_tokens_image(input.chunk);
+        const auto   last = mtmd_image_tokens_get_decoder_pos(img, 0, input.tokens - 1);
+        const int    w = last.x + 1, h = last.y + 1;
+        if (w * h != input.tokens) {
+            throw std::invalid_argument("unexpected merger grid");
+        }
+        Matrix v(input.tokens, width);
+        std::copy_n(mtmd_get_output_embd(vision), v.values.size(), v.row(0));
+        return Compressor(weights)(v, h, w, query);
+    }
+  public:
+    Engine(const string &  model,
+           const string &  projector,
+           llama_context * ctx,
+           mtmd_context *  vision,
+           llama_model *   language) :
+        ctx(ctx),
+        vision(vision),
+        language(language),
+        dictionary(model),
+        weights(TensorFile(projector).tasks()),
+        vocab(llama_model_get_vocab(language)),
+        width(llama_model_n_embd(language)),
+        ctxlen(llama_n_ctx_seq(ctx)) {
+        auto require = [&](const string & name, int rows, int cols) {
+            const auto i = weights.find("unimodel." + name);
+            if (i == weights.end() || i->second.rows != rows || i->second.cols != cols) {
+                throw std::runtime_error("invalid WePM tensor shape: " + name);
+            }
+        };
+        require("slot_pooler.embedding_slot", 1, width);
+        require("slot_pooler.decision_slot", 1, width);
+        require("embedding_head.weight", 2048, width);
+        require("decision_head.output.weight", 256, width);
+        require("mgvb.input_norm.weight", 1, width);
+        require("mgvb.input_proj.weight", 512, width);
+        require("mgvb.query_proj.weight", 512, 2 * width);
+        require("mgvb.global_queries", 8, 512);
+        require("mgvb.null_query", 1, 512);
+        require("mgvb.granularity_embedding.weight", 3, width);
+        require("mgvb.output_position.weight", width, 4);
+        for (const string bank : { "global", "region", "fine" }) {
+            const string prefix = "mgvb." + bank + "_";
+            require(prefix + "residual.norm.weight", 1, 512);
+            require(prefix + "residual.norm.bias", 1, 512);
+            require(prefix + "residual.fc1.weight", 1024, 512);
+            require(prefix + "residual.fc2.weight", width, 1024);
+            require(prefix + "value.weight", 512, 512);
+            if (bank == "global") {
+                require(prefix + "key.weight", 512, 512);
+                require(prefix + "query_condition.weight", 512, 512);
+            } else {
+                require(prefix + "query.weight", 512, 512);
+                require(prefix + "position.weight", 512, 4);
+                require(prefix + "score.weight", 1, 512);
+            }
+        }
+    }
+
+    json run(const json &                                request,
+             const vector<string> &                      images_data,
+             common_params_sampling &                    sampling,
+             const std::function<void(const string &)> & emit,
+             const std::function<bool()> &               cancelled) {
+        const string            task     = request.at("task");
+        bool                    generate = task == "generate", embed = task == "embed";
+        string                  text = request.at("prompt");
+        std::optional<Decision> decision;
+        if (!generate && !embed) {
+            if (images_data.size() > 8) {
+                throw std::runtime_error("too many decision images");
+            }
+            decision = render_decision(request);
+            text += decision->prompt;
+        }
+        if (!generate) {
+            text = "<|im_start|>user\n" + text + "<|im_end|>\n";
+        }
+        auto       start = ggml_time_us();
+        auto       ids   = tokenize(text);
+        const auto one   = [&](const string & s) {
+            auto tokens = tokenize(s);
+            if (tokens.size() != 1) {
+                throw std::runtime_error("special token mismatch");
+            }
+            return tokens[0];
+        };
+        int           image = one("<|image_pad|>"), eos = one("<|im_end|>"), pad = one("<|endoftext|>");
+        std::set<int> skip = { pad, eos, image };
+        for (auto s : { "<|vision_start|>", "<|vision_end|>", "<|video_pad|>", "<|audio_start|>", "<|audio_end|>",
+                        "<|audio_pad|>" }) {
+            skip.insert(one(s));
+        }
+        vector<ImageInput> prepared;
+        int64_t            required = int64_t(ids.size()) + 1;
+        for (const auto & bytes : images_data) {
+            if (cancelled()) {
+                throw std::runtime_error("request cancelled");
+            }
+            prepared.push_back(prepare_image(bytes));
+            required += std::min(prepared.back().tokens, 512) - 1;
+        }
+        if (required > ctxlen) {
+            if (!embed || !request.value("truncate", false)) {
+                throw std::invalid_argument("input exceeds context length");
+            }
+            const auto prefix = tokenize("<|im_start|>user\n").size(), suffix = tokenize("<|im_end|>\n").size();
+            int64_t    excess = required - ctxlen;
+            // Keep both framing tokens and every image in its original position.
+            // Recompute the MGVB query below from the retained text.
+            vector<llama_token> kept;
+            kept.reserve(ids.size());
+            for (size_t j = ids.size(); j-- > 0;) {
+                if (excess && j >= prefix && j + suffix < ids.size() && !skip.count(ids[j])) {
+                    --excess;
+                    continue;
+                }
+                kept.push_back(ids[j]);
+            }
+            if (excess) {
+                throw std::invalid_argument("images exceed context length");
+            }
+            ids.assign(kept.rbegin(), kept.rend());
+        }
+        Matrix                query(1, 2 * width);
+        std::map<int, Matrix> rows;
+        int                   count = 0, images = 0;
+        for (int token : ids) {
+            if (token == image) {
+                ++images;
+                continue;
+            }
+            if (!rows.count(token)) {
+                rows.emplace(token, dictionary.read("token_embd.weight", token, 1));
+            }
+            if (skip.count(token)) {
+                continue;
+            }
+            auto v = rows.at(token).row(0);
+            cblas_saxpy(width, 1, v, 1, query.row(0), 1);
+            std::copy_n(v, width, query.row(0) + width);
+            ++count;
+        }
+        if (images != int(images_data.size())) {
+            throw std::runtime_error("unmatched image marker");
+        }
+        if (count) {
+            cblas_sscal(width, 1.f / count, query.row(0), 1);
+        }
+        if (!generate) {
+            ids.push_back(pad);
+        }
+        vector<float>              data;
+        vector<std::array<int, 4>> positions;
+        vector<int>                native, compact;
+        int                        rope = 0;
+        for (size_t i = 0; i < ids.size(); ++i) {
+            if (ids[i] == image) {
+                if (cancelled()) {
+                    throw std::runtime_error("request cancelled");
+                }
+                const auto & input  = prepared.at(native.size());
+                auto         visual = encode(input, count ? &query : nullptr);
+                native.push_back(input.tokens);
+                compact.push_back(visual.tokens.rows);
+                int max_pos = 0;
+                for (auto p : visual.pos) {
+                    positions.push_back({ int(positions.size()), rope + p[1], rope + p[2], rope + p[0] });
+                    max_pos = std::max({ max_pos, p[0], p[1], p[2] });
+                }
+                rope += max_pos + 1;
+                data.insert(data.end(), visual.tokens.values.begin(), visual.tokens.values.end());
+            } else {
+                bool         slot = !generate && i + 1 == ids.size();
+                const auto & v    = slot ? weights.at(embed ? "unimodel.slot_pooler.embedding_slot" :
+                                                              "unimodel.slot_pooler.decision_slot") :
+                                           rows.at(ids[i]);
+                data.insert(data.end(), v.values.begin(), v.values.end());
+                positions.push_back({ int(positions.size()), rope, rope, rope });
+                ++rope;
+            }
+        }
+        int n = positions.size(), limit = generate ? request.value("max_tokens", 8) : 0;
+        if (n > ctxlen || (generate && n >= ctxlen)) {
+            throw std::runtime_error("prompt exceeds context length");
+        }
+        limit = limit < 0 ? ctxlen - n : std::min(limit, ctxlen - n);
+        Matrix batch(n, width);
+        batch.values.swap(data);
+        llama_memory_clear(llama_get_memory(ctx), true);
+        llama_set_causal_attn(ctx, true);
+        if (cancelled()) {
+            throw std::runtime_error("request cancelled");
+        }
+        auto output    = evaluate(batch, positions, !generate, cancelled);
+        auto prefilled = ggml_time_us();
+        json r         = {
+            { "native",       native  },
+            { "compact",      compact },
+            { "input_tokens", n       }
+        };
+        if (generate) {
+            owner<common_sampler, common_sampler_free> sampler(common_sampler_init(language, sampling),
+                                                               common_sampler_free);
+            if (!sampler) {
+                throw std::runtime_error("invalid sampler");
+            }
+            for (auto id : ids) {
+                common_sampler_accept(sampler.get(), id, false);
+            }
+            string pending, full;
+            bool   ended     = false;
+            int    predicted = 0;
+            auto   stops     = request.value("stop", vector<string>{});
+            for (int step = 0; step < limit; ++step) {
+                if (cancelled()) {
+                    throw std::runtime_error("request cancelled");
+                }
+                const auto token = common_sampler_sample(sampler.get(), ctx, -1);
+                ++predicted;
+                if (llama_vocab_is_eog(vocab, token)) {
+                    ended = true;
+                    break;
+                }
+                common_sampler_accept(sampler.get(), token, true);
+                pending += common_token_to_piece(vocab, token, false);
+                size_t hold = 0;
+                for (const auto & stop : stops) {
+                    if (stop.empty()) {
+                        continue;
+                    }
+                    auto pos = pending.find(stop);
+                    if (pos != string::npos) {
+                        pending.resize(pos);
+                        ended = true;
+                        break;
+                    }
+                    for (size_t k = 1; k <= std::min(stop.size() - 1, pending.size()); ++k) {
+                        if (pending.compare(pending.size() - k, k, stop, 0, k) == 0) {
+                            hold = std::max(hold, k);
+                        }
+                    }
+                }
+                auto part = pending.substr(0, pending.size() - std::min(hold, pending.size()));
+                if (!part.empty() && common_utf8_is_complete(part)) {
+                    full += part;
+                    emit(part);
+                    pending.erase(0, part.size());
+                }
+                if (ended || step + 1 == limit) {
+                    break;
+                }
+                evaluate(dictionary.read("token_embd.weight", token, 1),
+                         {
+                             { n + step, rope + step, rope + step, rope + step }
+                },
+                         false, cancelled);
+            }
+            if (!pending.empty()) {
+                full += pending;
+                emit(pending);
+            }
+            r["content"]   = full;
+            r["stop_type"] = ended ? "eos" : "limit";
+            r["timings"]   = {
+                { "prompt_n",     n                                     },
+                { "prompt_ms",    (prefilled - start) / 1000.0          },
+                { "predicted_n",  predicted                             },
+                { "predicted_ms", (ggml_time_us() - prefilled) / 1000.0 }
+            };
+        } else {
+            Matrix hidden(1, width);
+            hidden.values  = std::move(output);
+            auto projected = linear(
+                hidden, weights.at(embed ? "unimodel.embedding_head.weight" : "unimodel.decision_head.output.weight"));
+            if (embed) {
+                int dim = request.value("dimensions", 2048);
+                if (dim < 64 || dim > 2048 || (dim & (dim - 1))) {
+                    throw std::runtime_error("invalid dimension");
+                }
+                projected.values.resize(dim);
+                float norm = cblas_snrm2(dim, projected.row(0), 1);
+                if (!(norm > 0) || !std::isfinite(norm)) {
+                    throw std::runtime_error("invalid embedding");
+                }
+                cblas_sscal(dim, 1 / norm, projected.row(0), 1);
+                r["vector"] = projected.values;
+            } else {
+                int choices = decision->ids.size();
+                projected.values.resize(choices);
+                softmax(projected.row(0), choices);
+                r["answers"] = decision->answer(projected.values);
+            }
+        }
+        return r;
+    }
+};
+
+}  // namespace wepm
diff --git a/tools/server/wepm/heif.hpp b/tools/server/wepm/heif.hpp
new file mode 100644
index 0000000..6dd63d6
--- /dev/null
+++ b/tools/server/wepm/heif.hpp
@@ -0,0 +1,64 @@
+#pragma once
+#include "mtmd.h"
+
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+#ifdef WEPM_USE_HEIF
+#    include <libheif/heif.h>
+#endif
+
+namespace wepm {
+inline bool is_heif(const std::string & data) {
+    if (data.size() < 12 || data.compare(4, 4, "ftyp") != 0) {
+        return false;
+    }
+    const auto brand = data.substr(8, 4);
+    return brand == "heic" || brand == "heix" || brand == "mif1" || brand == "hevc" || brand == "hevx";
+}
+
+inline mtmd_bitmap * decode_heif(const std::string & data) {
+#ifdef WEPM_USE_HEIF
+    auto check = [](heif_error err) {
+        if (err.code != heif_error_Ok) {
+            throw std::invalid_argument(err.message ? err.message : "invalid HEIF image");
+        }
+    };
+    std::unique_ptr<heif_context, decltype(&heif_context_free)> ctx(heif_context_alloc(), heif_context_free);
+    if (!ctx) {
+        throw std::bad_alloc();
+    }
+    check(heif_context_read_from_memory_without_copy(ctx.get(), data.data(), data.size(), nullptr));
+    heif_image_handle * handle = nullptr;
+    check(heif_context_get_primary_image_handle(ctx.get(), &handle));
+    std::unique_ptr<heif_image_handle, decltype(&heif_image_handle_release)> owner(handle, heif_image_handle_release);
+    const int width = heif_image_handle_get_width(handle), height = heif_image_handle_get_height(handle);
+    if (width < 1 || height < 1 || int64_t(width) * height > 100000000) {
+        throw std::invalid_argument("invalid HEIF image dimensions");
+    }
+    heif_image * image = nullptr;
+    check(heif_decode_image(handle, &image, heif_colorspace_RGB, heif_chroma_interleaved_RGB, nullptr));
+    std::unique_ptr<heif_image, decltype(&heif_image_release)> decoded(image, heif_image_release);
+    int                                                        stride = 0;
+    auto      plane = heif_image_get_plane_readonly(image, heif_channel_interleaved, &stride);
+    const int w     = heif_image_get_width(image, heif_channel_interleaved);
+    const int h     = heif_image_get_height(image, heif_channel_interleaved);
+    if (!plane || w < 1 || h < 1 || int64_t(w) * h > 100000000 || stride < w * 3) {
+        throw std::invalid_argument("invalid HEIF RGB plane");
+    }
+    if (stride == w * 3) {
+        return mtmd_bitmap_init(w, h, plane);
+    }
+    std::vector<unsigned char> pixels(size_t(w) * h * 3);
+    for (int y = 0; y < h; ++y) {
+        std::memcpy(pixels.data() + size_t(y) * w * 3, plane + size_t(y) * stride, size_t(w) * 3);
+    }
+    return mtmd_bitmap_init(w, h, pixels.data());
+#else
+    (void) data;
+    throw std::invalid_argument("HEIF input requires a runner built with libheif");
+#endif
+}
+}  // namespace wepm
diff --git a/tools/server/wepm/mgvb.hpp b/tools/server/wepm/mgvb.hpp
new file mode 100644
index 0000000..fb6e539
--- /dev/null
+++ b/tools/server/wepm/mgvb.hpp
@@ -0,0 +1,227 @@
+// Query-conditioned visual compression for WePM task_slots_v1.
+#pragma once
+#include "blas.hpp"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace wepm {
+using std::string;
+using std::vector;
+
+struct Matrix {
+    int           rows, cols;
+    vector<float> values;
+
+    Matrix(int r, int c) : rows(r), cols(c), values(size_t(r) * c) {}
+
+    float * row(int i) { return values.data() + size_t(i) * cols; }
+
+    const float * row(int i) const { return values.data() + size_t(i) * cols; }
+};
+
+using Weights = std::map<string, Matrix>;
+
+inline Matrix linear(const Matrix & x, const Matrix & w) {
+    if (x.cols != w.cols) {
+        throw std::runtime_error("linear dimension mismatch");
+    }
+    Matrix y(x.rows, w.rows);
+    cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasTrans, x.rows, w.rows, x.cols, 1, x.row(0), x.cols, w.row(0), w.cols,
+                0, y.row(0), y.cols);
+    return y;
+}
+
+inline void softmax(float * x, int n) {
+    float mx = *std::max_element(x, x + n), sum = 0;
+    for (int i = 0; i < n; ++i) {
+        sum += (x[i] = std::exp(x[i] - mx));
+    }
+    for (int i = 0; i < n; ++i) {
+        x[i] /= sum;
+    }
+}
+
+struct Cell {
+    int top, left, bottom, right;
+};
+
+inline vector<Cell> partition(int h, int w, int count) {
+    vector<Cell> cells = {
+        { 0, 0, h, w }
+    };
+    auto rank = [](Cell c) {
+        int h = c.bottom - c.top, w = c.right - c.left;
+        return std::make_pair(h * w, std::max(h, w));
+    };
+    while (int(cells.size()) < count) {
+        auto it = std::max_element(cells.begin(), cells.end(), [&](Cell a, Cell b) { return rank(a) < rank(b); });
+        Cell a = *it, b = *it;
+        cells.erase(it);
+        if (a.right - a.left >= a.bottom - a.top) {
+            a.right = b.left = (a.left + a.right) / 2;
+        } else {
+            a.bottom = b.top = (a.top + a.bottom) / 2;
+        }
+        cells.push_back(a);
+        cells.push_back(b);
+    }
+    auto key = [](Cell c) {
+        return std::make_tuple(c.top, c.left, c.bottom, c.right);
+    };
+    std::sort(cells.begin(), cells.end(), [&](Cell a, Cell b) { return key(a) < key(b); });
+    return cells;
+}
+
+using Pos = std::array<int, 3>;  // t, y, x
+
+struct Visual {
+    Matrix      tokens;
+    vector<Pos> pos;
+};
+
+class Compressor {
+    const Weights & weights;
+
+    const Matrix & get(const string & name) const { return weights.at("unimodel.mgvb." + name); }
+
+    Matrix project(const Matrix & x, const string & name) const { return linear(x, get(name + ".weight")); }
+
+    Matrix residual(Matrix x, const string & bank) const {
+        string      name   = bank + "_residual.";
+        const auto &weight = get(name + "norm.weight"), &bias = get(name + "norm.bias");
+        for (int r = 0; r < x.rows; ++r) {
+            float * v    = x.row(r);
+            double  mean = 0, var = 0;
+            for (int j = 0; j < x.cols; ++j) {
+                mean += v[j];
+            }
+            mean /= x.cols;
+            for (int j = 0; j < x.cols; ++j) {
+                var += std::pow(v[j] - mean, 2);
+            }
+            float inv = 1 / std::sqrt(var / x.cols + 1e-5);
+            for (int j = 0; j < x.cols; ++j) {
+                v[j] = float(v[j] - mean) * inv * weight.values[j] + bias.values[j];
+            }
+        }
+        x = project(x, name + "fc1");
+        for (float & v : x.values) {
+            v = 0.5f * v * (1 + std::erf(v * 0.7071067811865475f));
+        }
+        return project(x, name + "fc2");
+    }
+  public:
+    explicit Compressor(const Weights & weights) : weights(weights) {}
+
+    Visual operator()(const Matrix & native, int h, int w, const Matrix * text) const {
+        if (native.rows != h * w || h <= 0 || w <= 0) {
+            throw std::runtime_error("invalid vision grid");
+        }
+        if (native.rows <= 512) {
+            Visual out{ native, {} };
+            for (int i = 0; i < native.rows; ++i) {
+                out.pos.push_back({ 0, i / w, i % w });
+            }
+            return out;
+        }
+        int          n = native.rows, H = native.cols;
+        Matrix       xn   = native;
+        const auto & norm = get("input_norm.weight");
+        for (int i = 0; i < n; ++i) {
+            float * row = xn.row(i);
+            float   inv = 1 / std::sqrt(cblas_sdot(H, row, 1, row, 1) / H + 1e-6f);
+            for (int j = 0; j < H; ++j) {
+                row[j] *= inv * norm.values[j];
+            }
+        }
+        auto       a = project(xn, "input_proj");
+        const int  d = a.cols, heads = 8, dh = d / heads;
+        const auto query = text ? project(*text, "query_proj") : get("null_query");
+        auto       q     = get("global_queries");
+        auto       shift = project(query, "global_query_condition");
+        auto       k = project(a, "global_key"), v = project(a, "global_value");
+        Matrix     maps(8, n), pooled(8, d);
+        for (int g = 0; g < 8; ++g) {
+            for (int j = 0; j < d; ++j) {
+                q.row(g)[j] += shift.values[j];
+            }
+            for (int head = 0; head < heads; ++head) {
+                vector<float> p(n);
+                const int     start = head * dh;
+                for (int i = 0; i < n; ++i) {
+                    p[i] = cblas_sdot(dh, q.row(g) + start, 1, k.row(i) + start, 1) / std::sqrt(float(dh));
+                }
+                softmax(p.data(), n);
+                for (int i = 0; i < n; ++i) {
+                    maps.row(g)[i] += p[i] / heads;
+                    cblas_saxpy(dh, p[i], v.row(i) + start, 1, pooled.row(g) + start, 1);
+                }
+            }
+        }
+        Visual out{ Matrix(512, H), {} };
+        auto   rg = residual(std::move(pooled), "global");
+        cblas_sgemm(CblasRowMajor, CblasNoTrans, CblasNoTrans, 8, H, n, 1, maps.row(0), n, native.row(0), H, 0,
+                    out.tokens.row(0), H);
+        cblas_saxpy(8 * H, 1, rg.row(0), 1, out.tokens.row(0), 1);
+        out.pos.assign(8, Pos{ 0, (h - 1) / 2, (w - 1) / 2 });
+        Matrix coords(n, 4);
+        for (int i = 0; i < n; ++i) {
+            coords.row(i)[1] = float(i / w) / std::max(1, h - 1);
+            coords.row(i)[2] = float(i % w) / std::max(1, w - 1);
+            coords.row(i)[3] = 1.0f / n;
+        }
+        for (const string bank : { "region", "fine" }) {
+            int  count = bank == "region" ? 64 : 440, halo = bank == "region" ? 1 : 0, offset = out.pos.size();
+            auto scores = project(a, bank + "_value"), qp = project(query, bank + "_query"),
+                 pp = project(coords, bank + "_position");
+            for (int i = 0; i < n; ++i) {
+                for (int j = 0; j < d; ++j) {
+                    scores.row(i)[j] = std::tanh(scores.row(i)[j] + qp.values[j] + pp.row(i)[j]);
+                }
+            }
+            auto   logits = project(scores, bank + "_score");
+            Matrix pa(count, d);
+            auto   cells = partition(h, w, count);
+            for (int z = 0; z < count; ++z) {
+                Cell c = cells[z];
+                out.pos.push_back({ 0, (c.top + c.bottom - 1) / 2, (c.left + c.right - 1) / 2 });
+                vector<int>   indices;
+                vector<float> p;
+                for (int y = std::max(0, c.top - halo); y < std::min(h, c.bottom + halo); ++y) {
+                    for (int x = std::max(0, c.left - halo); x < std::min(w, c.right + halo); ++x) {
+                        indices.push_back(y * w + x);
+                        p.push_back(logits.values[y * w + x]);
+                    }
+                }
+                softmax(p.data(), p.size());
+                for (size_t j = 0; j < p.size(); ++j) {
+                    cblas_saxpy(H, p[j], native.row(indices[j]), 1, out.tokens.row(offset + z), 1);
+                    cblas_saxpy(d, p[j], a.row(indices[j]), 1, pa.row(z), 1);
+                }
+            }
+            auto res = residual(std::move(pa), bank);
+            cblas_saxpy(count * H, 1, res.row(0), 1, out.tokens.row(offset), 1);
+        }
+        Matrix pc(512, 4);
+        for (int i = 0; i < 512; ++i) {
+            pc.row(i)[1] = float(out.pos[i][1]) / std::max(1, h - 1);
+            pc.row(i)[2] = float(out.pos[i][2]) / std::max(1, w - 1);
+        }
+        auto         decor = project(pc, "output_position");
+        const auto & type  = get("granularity_embedding.weight");
+        for (int i = 0; i < 512; ++i) {
+            for (int j = 0; j < H; ++j) {
+                out.tokens.row(i)[j] += type.row(i < 8 ? 0 : i < 72 ? 1 : 2)[j] + decor.row(i)[j];
+            }
+        }
+        return out;
+    }
+};
+}  // namespace wepm
